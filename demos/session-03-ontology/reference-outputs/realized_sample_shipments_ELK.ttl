@base <https://ul.edu.lb/kr/sample-shipments> .

<https://ul.edu.lb/kr/sample-shipments> rdf:type owl:Ontology ;
                                         owl:imports ul: ;
                                         rdfs:label "UL Knowledge Representation course: sample shipments (ABox)" .

#################################################################
#    Individuals
#################################################################

###  https://spec.industrialontologies.org/ontology/individual/GLNScheme
<https://spec.industrialontologies.org/ontology/individual/GLNScheme> rdf:type ioc:LocationIdentificationScheme .


###  https://spec.industrialontologies.org/ontology/individual/Provisional
<https://spec.industrialontologies.org/ontology/individual/Provisional> rdf:type ioc:MaturityLevel .


###  https://spec.industrialontologies.org/ontology/individual/Released
<https://spec.industrialontologies.org/ontology/individual/Released> rdf:type ioc:MaturityLevel .


###  https://ul.edu.lb/kr/scm#carrier-blackline
ul:carrier-blackline rdf:type owl:NamedIndividual ,
                              ul:SanctionedCarrier ;
                     rdfs:label "Blackline Freight (fictional, sanctioned)" .


###  https://ul.edu.lb/kr/scm#carrier-dhl
ul:carrier-dhl rdf:type owl:NamedIndividual ,
                        ioc:Carrier ;
               rdfs:label "DHL" .


###  https://ul.edu.lb/kr/scm#ship-4471
ul:ship-4471 rdf:type owl:NamedIndividual ,
                      ioc:Shipment ;
             ul:handledBy ul:carrier-dhl ;
             rdfs:label "shipment 4471" .


###  https://ul.edu.lb/kr/scm#ship-4472
ul:ship-4472 rdf:type owl:NamedIndividual ,
                      ioc:Shipment ,
                      ul:AtRiskShipment ;
             ul:handledBy ul:carrier-blackline ;
             rdfs:label "shipment 4472" .


###  https://ul.edu.lb/kr/scm#ship-4473
ul:ship-4473 rdf:type owl:NamedIndividual ,
                      ul:AtRiskShipment ;
             ul:handledBy ul:carrier-blackline ;
             rdfs:label "shipment 4473" .


