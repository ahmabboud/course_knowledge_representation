@prefix : <https://ul.edu.lb/kr/scm#> .
@prefix ul: <https://ul.edu.lb/kr/scm#> .
@prefix gs1: <https://gs1.org/voc/> .
@prefix ioc: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof: <https://spec.industrialontologies.org/ontology/core/Core/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <https://ul.edu.lb/kr/scm#> .

<https://ul.edu.lb/kr/scm#> rdf:type owl:Ontology ;
                             owl:imports <https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/> ;
                             rdfs:label "UL Knowledge Representation course: supply chain reference ontology" .

#################################################################
#    Annotation properties
#################################################################

###  https://ul.edu.lb/kr/scm#answersCQ
ul:answersCQ rdf:type owl:AnnotationProperty ;
             rdfs:comment "The competency question (see competency_questions.md) this class exists to answer. A class with none has not earned its place, per the lecture's own rule." ;
             rdfs:label "answers competency question" .


###  https://ul.edu.lb/kr/scm#profile
ul:profile rdf:type owl:AnnotationProperty ;
           rdfs:comment "EL, DL or QL: which profile this axiom set was written for. Tagged here using this course's own working rule (see the lab brief's terminal check): a class stays EL as long as it only uses conjunction and someValuesFrom; allValuesFrom, cardinality, complementOf or inverseOf push it to DL." ;
           rdfs:label "intended OWL profile" .


#################################################################
#    Object Properties
#################################################################

###  https://ul.edu.lb/kr/scm#actuallyServed
ul:actuallyServed rdf:type owl:ObjectProperty ;
                  rdfs:domain ul:Plant ;
                  rdfs:range ul:Port ;
                  rdfs:comment "A plant having actually shipped through a port, an operational fact, independent of ul:PlantPortAuthorization, an authorized plant that has never shipped through that port has the authorization without this."@en ;
                  rdfs:label "actually served"@en .


###  https://ul.edu.lb/kr/scm#appliesToRoute
ul:appliesToRoute rdf:type owl:ObjectProperty ;
                  rdfs:domain ul:FreightRateBand ;
                  rdfs:range ioc:ShippingRoute ;
                  rdfs:label "applies to route"@en .


###  https://ul.edu.lb/kr/scm#authorizes
ul:authorizes rdf:type owl:ObjectProperty ;
              rdfs:domain ul:PlantPortAuthorization ;
              rdfs:range ul:Port ;
              rdfs:label "authorizes"@en .


###  https://ul.edu.lb/kr/scm#committedBefore
ul:committedBefore rdf:type owl:ObjectProperty ;
                   owl:inverseOf ul:deliveredAfter ;
                   rdfs:label "committed before"@en .


###  https://ul.edu.lb/kr/scm#deliveredAfter
ul:deliveredAfter rdf:type owl:ObjectProperty ;
                  rdfs:domain ul:LateShipment ;
                  rdfs:label "delivered after"@en .


###  https://ul.edu.lb/kr/scm#handledBy
ul:handledBy rdf:type owl:ObjectProperty ;
             rdfs:domain ioc:Shipment ;
             rdfs:range ioc:Carrier ;
             rdfs:label "handled by"@en .


###  https://ul.edu.lb/kr/scm#handlesRoute
ul:handlesRoute rdf:type owl:ObjectProperty ;
                rdfs:domain ioc:Carrier ;
                rdfs:range ioc:ShippingRoute ;
                rdfs:label "handles route"@en .


###  https://ul.edu.lb/kr/scm#hasComponent
ul:hasComponent rdf:type owl:ObjectProperty ;
                rdfs:domain ioc:MaterialProduct ;
                rdfs:range ioc:MaterialComponent ;
                rdfs:comment "A finished product has this material component as a physical part."@en ;
                rdfs:label "has component"@en .


###  https://ul.edu.lb/kr/scm#heldBy
ul:heldBy rdf:type owl:ObjectProperty ;
          rdfs:domain ul:PlantPortAuthorization ;
          rdfs:range ul:Plant ;
          rdfs:label "held by"@en .


###  https://ul.edu.lb/kr/scm#ordersProduct
ul:ordersProduct rdf:type owl:ObjectProperty ;
                 rdfs:domain ioc:PurchaseOrder ;
                 rdfs:range ioc:MaterialProduct ;
                 rdfs:label "orders product"@en .


###  https://ul.edu.lb/kr/scm#suppliedBy
ul:suppliedBy rdf:type owl:ObjectProperty ;
              rdfs:domain ioc:MaterialComponent ;
              rdfs:range ioc:Supplier ;
              rdfs:comment "A material component is bought from this supplier."@en ;
              rdfs:label "supplied by"@en .


#################################################################
#    Data properties
#################################################################

###  https://ul.edu.lb/kr/scm#maxWeightKg
ul:maxWeightKg rdf:type owl:DatatypeProperty ;
               rdfs:domain ul:FreightRateBand ;
               rdfs:range xsd:decimal ;
               rdfs:label "maximum weight, kg"@en .


###  https://ul.edu.lb/kr/scm#minWeightKg
ul:minWeightKg rdf:type owl:DatatypeProperty ;
               rdfs:domain ul:FreightRateBand ;
               rdfs:range xsd:decimal ;
               rdfs:label "minimum weight, kg"@en .


###  https://ul.edu.lb/kr/scm#sanctionsListStatus
ul:sanctionsListStatus rdf:type owl:DatatypeProperty ;
                       rdfs:domain ioc:Carrier ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Asserted per carrier record from the sanctions-screening feed, not derived by the reasoner, screening is a lookup against an external list, not an entailment."@en ;
                       rdfs:label "sanctions list status"@en .


