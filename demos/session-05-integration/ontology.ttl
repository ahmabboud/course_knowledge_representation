# The small slice of the Session 3 ontology this lab actually maps to.
# Extend from your team's real ontology file; this is enough for
# Ontop's -t flag and for the SPARQL query below to type-check against.
@prefix ul: <https://ul.edu.lb/kr/scm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://ul.edu.lb/kr/scm> a owl:Ontology .

ul:PurchaseOrder a owl:Class .
ul:Carrier a owl:Class .
ul:hasCarrier a owl:ObjectProperty ; rdfs:domain ul:PurchaseOrder ; rdfs:range ul:Carrier .
ul:carrierName a owl:DatatypeProperty ; rdfs:domain ul:Carrier .
ul:dispatchDate a owl:DatatypeProperty ; rdfs:domain ul:PurchaseOrder .
ul:deliveryDate a owl:DatatypeProperty ; rdfs:domain ul:PurchaseOrder .
