# RML mapping, Session 3's ontology over Session 5's Postgres source.
#
# This is a starting mapping (per this folder's README), the two
# TriplesMaps below cover purchase_orders and carriers as loaded by
# load_postgres.py. Extend it as your own team's schema grows.
#
# Materialize it with Morph-KGC, a separate venv from the shared one
# (see load_postgres.py's docstring): morph-kgc pins rdflib<7.3.0,
# pyshacl (the repository's shared dependency, Session 4 onward) needs
# rdflib>=7.3.0. They cannot coexist in one environment; validate the
# materialized .ttl output in the shared venv, in a second step.
#
#   python3 -m venv .venv-materialize && source .venv-materialize/bin/activate
#   pip install morph-kgc psycopg2-binary
#   python3 -m morph_kgc config_materialize.ini
#
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix ul: <https://ul.edu.lb/kr/scm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#CarrierMap> a rr:TriplesMap ;
  rml:logicalSource [
    rr:tableName "carriers" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "https://ul.edu.lb/kr/scm#carrier-{carrier_code}" ;
    rr:class ul:Carrier
  ] ;
  rr:predicateObjectMap [
    rr:predicate ul:carrierName ;
    rr:objectMap [ rml:reference "carrier_name" ; rr:datatype xsd:string ]
  ] .

<#PurchaseOrderMap> a rr:TriplesMap ;
  rml:logicalSource [
    rr:tableName "purchase_orders" ;
    rml:referenceFormulation ql:CSV
  ] ;
  rr:subjectMap [
    rr:template "https://ul.edu.lb/kr/scm#{po_id}" ;
    rr:class ul:PurchaseOrder
  ] ;
  rr:predicateObjectMap [
    # A foreign key becomes an object property via rr:parentTriplesMap
    # plus rr:joinCondition, not a literal copy of the raw code. A row
    # whose carrier_code is NULL or matches no carrier (po99, below)
    # simply produces no ul:hasCarrier triple, silently, this is the
    # exact gap Session 4's shapes are meant to catch, on purpose.
    rr:predicate ul:hasCarrier ;
    rr:objectMap [
      rr:parentTriplesMap <#CarrierMap> ;
      rr:joinCondition [
        rr:child "carrier_code" ;
        rr:parent "carrier_code"
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate ul:dispatchDate ;
    rr:objectMap [ rml:reference "dispatch_date" ; rr:datatype xsd:date ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate ul:deliveryDate ;
    rr:objectMap [ rml:reference "delivery_date" ; rr:datatype xsd:date ]
  ] .
